# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from the Developer Portal → Bot → Reset Token
DISCORD_TOKEN=your-bot-token-here

# Your server's ID (Developer Mode on → right-click server icon → Copy Server ID)
GUILD_ID=123456789012345678

# Optional: text channel for the weekly leaderboard post (right-click channel → Copy Channel ID).
# Leave empty to turn the weekly post off.
LEADERBOARD_CHANNEL_ID=
